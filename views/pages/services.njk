{% extends "layouts/base.njk" %}
{% from "partials/ui.njk" import icon, cta, picture, checkList, breadcrumbs, ctaBand, profileCard, browserMock %}

{% block content %}

<section class="page-hero on-dark" aria-labelledby="page-title">
  <div class="container">
    {{ breadcrumbs(page.trail) }}
    <p class="eyebrow">Services and pricing</p>
    <h1 id="page-title">Fixed-price help for getting found locally</h1>
    <p class="page-hero__lead">Two one-time services, each with a clear scope and a price you can see up front. No retainers and no contracts.</p>
  </div>
</section>

{% for service in services %}
<section class="section{% if loop.index is even %} section--tint{% endif %}" id="{{ service.slug }}" aria-labelledby="{{ service.slug }}-title">
  <div class="container offer{% if loop.index is even %} offer--flip{% endif %}">
    <div class="offer__visual" data-reveal>
      {% if service.illustration == "profile" %}{{ profileCard(false) }}{% else %}{{ browserMock() }}{% endif %}
    </div>
    <div class="offer__copy">
      <p class="eyebrow">{{ service.kind }}</p>
      <h2 id="{{ service.slug }}-title">{{ service.name }}</h2>
      <p class="lead">{{ service.teaser }}</p>
      {{ checkList(service.highlights) }}
      <dl class="offer__facts">
        <div><dt>Price</dt><dd>{{ service.price | money }}</dd></div>
        <div><dt>Timeline</dt><dd>{{ service.turnaround }}</dd></div>
        <div><dt>Commitment</dt><dd>One-time</dd></div>
      </dl>
      <div class="offer__actions">
        <a class="btn btn--primary" href="/services/{{ service.slug }}" data-cta="See full details" data-cta-location="services: {{ service.slug }}">See full details<span class="visually-hidden"> of the {{ service.name }}</span></a>
        <a class="btn btn--outline" href="/free-consultation?service={{ service.slug }}" data-cta="Book a Free Consultation" data-cta-location="services: {{ service.slug }}">Book a Free Consultation</a>
      </div>
    </div>
  </div>
</section>
{% endfor %}

<section class="section" aria-labelledby="choose-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Not sure which one you need?</p>
      <h2 id="choose-title">A quick way to choose.</h2>
    </header>
    <div class="choose-grid">
      <article class="choose" data-reveal>
        {{ icon("pin", "choose__icon") }}
        <h3>Start with your Google profile if&hellip;</h3>
        <p>People can already find you on Google, but what they see is wrong, thin or out of date.</p>
        <a class="text-link" href="/services/google-business-profile">About the Online Presence Starter{{ icon("arrow") }}</a>
      </article>
      <article class="choose" data-reveal>
        {{ icon("globe", "choose__icon") }}
        <h3>Start with a website if&hellip;</h3>
        <p>You have nowhere of your own to send people who want to know more about you.</p>
        <a class="text-link" href="/services/website-design">About the Simple Business Website{{ icon("arrow") }}</a>
      </article>
      <article class="choose" data-reveal>
        {{ icon("chat", "choose__icon") }}
        <h3>Need something else?</h3>
        <p>Tell us what you need and we will follow up with a custom plan.</p>
        <a class="text-link" href="/contact">Send us a message{{ icon("arrow") }}</a>
      </article>
    </div>
    <div class="photo-band" data-reveal>
      {{ picture("open-door", "A glass shop door with a hanging sign that reads: Yes, we are open", 1200, 600, "(min-width: 1180px) 1100px, 92vw") }}
      <p>The two services work well together: an accurate Google profile helps people find you, and a simple website gives them somewhere to land.</p>
    </div>
  </div>
</section>

{{ ctaBand("services final cta", "Not sure where to start?", "Book a free " ~ site.consultation.minutes ~ "-minute consultation and we will point you to the right service, or tell you honestly if you do not need one.") }}

{% endblock %}
