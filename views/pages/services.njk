{% extends "layouts/base.njk" %}
{% from "partials/ui.njk" import icon, planPrice, checkList, breadcrumbs %}

{% block content %}

<section class="page-hero on-dark" aria-labelledby="page-title">
  <div class="container">
    {{ breadcrumbs(page.trail) }}
    <p class="eyebrow">Services and pricing</p>
    <h1 id="page-title" class="split-phrases">{% for phrase in pricing.hero.heading.split(". ") %}<span>{{ phrase }}{% if not loop.last %}.{% endif %}</span> {% endfor %}</h1>
    <p class="page-hero__lead">{{ pricing.hero.lead }}</p>
  </div>
</section>

<section class="section section--tint" aria-labelledby="plans-title">
  <div class="container">
    <h2 class="visually-hidden" id="plans-title">Packages and prices</h2>

    <div class="plan-grid">
      {% for service in services %}
      {% set card = service.card %}
      <article class="plan" id="{{ service.slug }}" aria-labelledby="{{ service.slug }}-name">
        <h3 class="plan__name" id="{{ service.slug }}-name">{{ card.name or service.name }}</h3>
        {{ planPrice(service, "plan__price") }}
        <p class="plan__desc">{{ card.description }}</p>

        {{ checkList(card.included, "plan__list") }}

        <div class="plan__note">
          <p class="plan__note-title">Not included / add-ons</p>
          <p>{{ card.notIncluded }}{% if card.addOn %} {{ card.addOn }}{% endif %}</p>
        </div>

        <p class="plan__best"><strong>Best for:</strong> {{ card.bestFor }}</p>
        {% if service.hasPage %}
        <a class="text-link plan__more" href="{{ service.url }}">Full details<span class="visually-hidden"> about {{ card.name or service.name }}</span>{{ icon("arrow") }}</a>
        {% endif %}

        <div class="plan__actions">
          <a class="btn btn--primary" href="/free-consultation?service={{ service.slug }}" data-cta="{{ card.button }}" data-cta-location="pricing card: {{ service.slug }}">{{ card.button }}</a>
        </div>
      </article>
      {% endfor %}
    </div>

    <aside class="bundle" aria-label="Bundle offer">
      <p class="bundle__text">{{ pricing.bundle.text }}</p>
      <a class="btn btn--primary btn--lg" href="/free-consultation?service={{ pricing.bundle.service }}" data-cta="{{ pricing.bundle.button }}" data-cta-location="pricing bundle">{{ pricing.bundle.button }}</a>
    </aside>

    <p class="terms-note">{{ icon("shield") }}<span>{{ pricing.termsNote }}</span></p>
  </div>
</section>

{% endblock %}
