{# Analytics loaders. Nothing here is sent to the browser unless a tracking ID is set in the environment.
   These are Google's standard snippets, unchanged apart from the ID. #}
{% if tracking.mode == 'gtm' %}
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ tracking.gtmId }}');</script>
{% elif tracking.mode == 'gtag' %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ tracking.ga4Id or tracking.adsId }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());{% if tracking.ga4Id %}gtag('config','{{ tracking.ga4Id }}');{% endif %}{% if tracking.adsId %}gtag('config','{{ tracking.adsId }}');{% endif %}</script>
{% endif %}
