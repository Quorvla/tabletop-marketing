<!doctype html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}">
{% if page.noindex %}
<meta name="robots" content="noindex, follow">
{% endif %}
<link rel="canonical" href="{{ page.canonical }}">
{% if tracking.searchConsoleToken %}
<meta name="google-site-verification" content="{{ tracking.searchConsoleToken }}">
{% endif %}
<meta name="theme-color" content="#071C29">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_CA">
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:url" content="{{ page.canonical }}">
<meta property="og:image" content="{{ site.url }}/images/og-default.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }}. {{ site.tagline }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/fraunces-latin-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ asset('/css/site.css') }}">
{% include "partials/tracking-head.njk" %}
<script type="application/ld+json">{{ page.schema | jsonld | safe }}</script>
</head>
<body{% if tracking.mode == 'gtag' and tracking.adsId and tracking.adsLeadLabel %} data-ads-lead="{{ tracking.adsId }}/{{ tracking.adsLeadLabel }}"{% endif %}>
{% if tracking.mode == 'gtm' %}
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ tracking.gtmId }}" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
{% endif %}
<a class="skip-link" href="#main">Skip to main content</a>
{% include "partials/header.njk" %}
<main id="main" tabindex="-1">
{% block content %}{% endblock %}
</main>
{% include "partials/footer.njk" %}
<script src="{{ asset('/js/site.js') }}" defer></script>
</body>
</html>
